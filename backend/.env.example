# Copia in backend/.env e sostituisci i valori fittizi. Il file .env non va nel repository.

# ─── Database (utente applicativo, soggetto a RLS) ───────────────────
PG_USER=standmanager_app
PG_PASSWORD=yourpassword
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=standmanager

# Ruolo del pannello master (/master): l'unico che può creare, modificare ed eliminare tenant.
# Va creato prima della migrazione 025: CREATE ROLE standmanager_master LOGIN PASSWORD '...';
PG_MASTER_USER=standmanager_master
PG_MASTER_PASSWORD=yourmasterpassword

# Solo per `npm run migrate`: utente privilegiato per le DDL. L'app non la usa mai.
MIGRATION_DATABASE_URL=postgres://migration_user:yourpassword@localhost:5432/standmanager

# ─── Autenticazione ──────────────────────────────────────────────────
# Stringa casuale lunga (es. `openssl rand -hex 32`)
JWT_SECRET=change-this-to-a-random-64-char-string

# Master panel (gestione tenant): hash bcrypt della password e segreto dei suoi token
# Hash: node -e "require('bcrypt').hash('la-tua-password', 12).then(console.log)"
MASTER_PASSWORD_HASH=$2b$12$sostituisci-con-un-hash-bcrypt
MASTER_JWT_SECRET=another-random-64-char-string

# ─── Server ──────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Dominio dell'app: ogni tenant è un suo sottodominio (es. prova.smarteats.local).
# In produzione il dominio reale; fuori produzione sono ammessi anche localhost e IP LAN.
APP_DOMAIN=smarteats.local

# Certificati HTTPS (mkcert in sviluppo). Senza queste variabili si cercano i file
# _wildcard.smarteats.local+4*.pem nella cartella backend.
HTTPS_KEY_PATH=/percorso/_wildcard.smarteats.local+4-key.pem
HTTPS_CERT_PATH=/percorso/_wildcard.smarteats.local+4.pem

# ─── Avvisi WhatsApp (modulo `whatsapp`, docs/design-whatsapp.md) ─────
# mock = sviluppo e test (non esce nulla), meta = WhatsApp Business Platform, off = spento (default in produzione)
WHATSAPP_DRIVER=mock
# Solo per `meta`: token di accesso permanente dell'utente di sistema e id del numero (Meta for Developers)
WHATSAPP_TOKEN=token-fittizio
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_API_VERSION=v21.0
# Webhook: URL https://<dominio>/api/webhooks/whatsapp. Token di verifica a scelta e segreto dell'app (Meta → Impostazioni app → Di base)
WHATSAPP_VERIFY_TOKEN=un-token-a-scelta
WHATSAPP_APP_SECRET=segreto-app-fittizio
# Solo per `npm run whatsapp:templates`: id dell'account WhatsApp Business e base dei link (di norma https://<dominio>)
WHATSAPP_WABA_ID=000000000000000
WHATSAPP_LINK_BASE=https://smarteats.local

# ─── Pagine /privacy e /terms: chi fornisce il servizio ──────────────
LEGAL_NAME=Nome del fornitore
LEGAL_EMAIL=privacy@esempio.it
LEGAL_ADDRESS=
LEGAL_VAT=
