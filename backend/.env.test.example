# Configurazione dei test di integrazione (npm run test:integration).
# Copia in backend/.env.test: il file reale non va nel repository.

# Database di prova: stesso schema di schema.sql, con l'utente applicativo soggetto a RLS
PG_USER=smarteats_app
PG_PASSWORD=yourpassword
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=smarteats_test

PG_MASTER_USER=smarteats_master
PG_MASTER_PASSWORD=yourmasterpassword

# Utente privilegiato dello stesso database: prepara e cancella i tenant di prova
TEST_DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/smarteats_test

JWT_SECRET=una-stringa-di-prova-lunga-almeno-32-caratteri
LOG_LEVEL=silent
